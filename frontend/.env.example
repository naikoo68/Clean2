# Base URL of the backend API.
# Local development:
VITE_API_URL=http://localhost:5000/api
# Production (backend on Render):
# VITE_API_URL=https://my-prep-mart-api-39nk.onrender.com/api


# (Optional) Google OAuth Web Client ID for "Back up / Restore to Google Drive".
# Set this in Vercel to turn the feature on by default for everyone. A Client ID
# saved in Admin -> Backup & Restore always overrides this value.
# VITE_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
